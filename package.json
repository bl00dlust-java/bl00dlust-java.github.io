{
  "name": "cyberhygiene-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/copy-legacy.mjs && npm run validate:content && node scripts/validate-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:legacy": "tsc --noEmit -p tsconfig.json",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:build": "node scripts/validate-build.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "border-beam": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.13.4"
  }
}
