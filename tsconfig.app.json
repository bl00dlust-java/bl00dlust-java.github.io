{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/main.tsx",
    "src/react-app.tsx",
    "src/components/**/*.tsx",
    "src/admin-main.tsx",
    "src/admin-app.tsx"
  ]
}
